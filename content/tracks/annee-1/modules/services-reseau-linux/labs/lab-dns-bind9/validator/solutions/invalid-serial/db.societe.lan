$TTL    86400
@       IN      SOA     ns1.societe.lan. admin.societe.lan. (
                        1               ; Invalid Serial format
                        28800
                        7200
                        2419200
                        3600 )
;
@       IN      NS      ns1.societe.lan.
@       IN      NS      ns2.societe.lan.

@       IN      MX  10  mail.societe.lan.

ns1     IN      A       192.168.10.10
ns2     IN      A       192.168.10.11
mail    IN      A       192.168.10.15
srv-web IN      A       192.168.10.20
srv-db  IN      A       192.168.10.30

www     IN      CNAME   srv-web.societe.lan.
intranet IN     CNAME   srv-web.societe.lan.
