#cloud-config

hostname: srv-web-prod
fqdn: srv-web-prod.societe.lan
manage_etc_hosts: true

users:
  - name: mauvais-user
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash

packages:
  - qemu-guest-agent
  - curl
  - htop
  - ufw
  - git

runcmd:
  - systemctl enable --now qemu-guest-agent
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow 22/tcp
  - ufw --force enable
