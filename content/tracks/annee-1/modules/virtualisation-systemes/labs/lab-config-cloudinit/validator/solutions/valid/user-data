#cloud-config

hostname: srv-web-prod
fqdn: srv-web-prod.societe.lan
manage_etc_hosts: true

package_update: true
package_upgrade: true

users:
  - name: admin-sys
    gecos: Administrateur Système
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: sudo, adm
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIG1234567890abcdefghijklmnopqrstuvwxyz admin@societe.lan

packages:
  - qemu-guest-agent
  - curl
  - htop
  - ufw
  - git

runcmd:
  - systemctl enable --now qemu-guest-agent
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow 22/tcp
  - ufw --force enable
