# Profil client nomade — solution de référence
# À compléter avec le certificat client embarqué (jamais partagé !)

client
dev tun
proto udp
remote 203.0.113.10 1194

tls-version-min 1.2
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
auth-nocache

# Vérification du serveur via la CA embarquée
<ca>
# -----BEGIN CERTIFICATE-----
# (certificat de la CA racine d'entreprise)
# -----END CERTIFICATE-----
</ca>