# ==============================================================================
# OpenSIO — Configuration d'environnement (Template)
# ==============================================================================

# Environnement d'exécution (development | production)
NODE_ENV=development

# URLs applicatives
APP_URL=http://localhost:3000
API_PORT=4000

# Base de données PostgreSQL (D-03)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opensio?schema=public"
DB_PASSWORD=opensio-super-secure-dev-db-pass-2026!

# Authentification JWT HS256 (D-09) — Secret de 64 octets minimum
JWT_SECRET=4f9b8c2d1e0a7f6e5d4c3b2a1908f7e6d5c4b3a291807f6e5d4c3b2a10987654a1b2c3d4e5f60718293a4b5c6d7e8f90123456789abcdef0123456789abcdef0
REFRESH_TOKEN_TTL_DAYS=7
REGISTRATION_ENABLED=false
SINGLE_USER_MODE=false

# Source de vérité du contenu pédagogique (D-02)
CONTENT_PATH=./content
CONTENT_GIT_REMOTE=

# Moteur d'exécution des labs (D-07, D-08) — Options: simulation | docker | proxmox
LAB_RUNNER=simulation
LAB_SESSION_TTL_MINUTES=45
LAB_MAX_GLOBAL_VMS=2
DOCKER_SOCKET_PROXY_URL=

# Terminal web (D-14, v0.2)
TERMINAL_ENABLED=false

# Cache et files de tâches (v0.2)
REDIS_URL=

# Module d'assistance IA (D-16, v0.2)
AI_ENABLED=true
AI_PROVIDER=openai-compatible
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=llama3.1:8b
AI_API_KEY=
AI_RATE_LIMIT_PER_HOUR=20

# Orchestration Proxmox VE (v1.0)
PROXMOX_API_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_POOL=labs
PROXMOX_TEMPLATE_IDS=
PROXMOX_SIMULATE_FAILURE_RATE=0
NOVNC_ENABLED=false

# Notifications & SMTP (optionnel)
SMTP_URL=

# Sauvegardes (D-18)
BACKUP_DIR=/backups
BACKUP_COPY_TARGET=

SEED_ADMIN_EMAIL=admin@opensio.local
SEED_ADMIN_PASSWORD=Admin12345678!
SEED_ADMIN_NAME=Ton Nom
DEMO_SEED=true
