# ==============================================================================
# OpenSIO — Variables d'Environnement Production
# Copiez ce fichier vers .env.production et remplissez les valeurs.
# Vous pouvez générer un fichier prêt à l'emploi via :
# node scripts/generate-secrets.mjs
# ==============================================================================

# Domaine public ou "localhost" (Caddy gérera TLS automatiquement)
DOMAIN=localhost

# ------------------------------------------------------------------------------
# Base de données
# ------------------------------------------------------------------------------
# Générez un mot de passe sécurisé : openssl rand -hex 32
POSTGRES_PASSWORD=change-me
# Format: postgresql://opensio:MOT_DE_PASSE@db:5432/opensio?schema=public
DATABASE_URL=postgresql://opensio:change-me@db:5432/opensio?schema=public

# ------------------------------------------------------------------------------
# Sécurité & Authentification
# ------------------------------------------------------------------------------
# Secret pour signer les JWT (HS256). Générez min 64 caractères :
# openssl rand -base64 48
JWT_SECRET=change-this-to-a-very-secure-random-64-bytes-secret-key-for-jwt-signing

# Inscription ouverte au public ? (false par défaut en prod)
REGISTRATION_ENABLED=false

# ------------------------------------------------------------------------------
# Administrateur par défaut (Créé au premier lancement)
# ------------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@opensio.local
SEED_ADMIN_PASSWORD=Admin12345678!

# ------------------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------------------
# URL publique de l'API (pour le client Next.js).
# Laissez "/api/v1" pour utiliser le même domaine via le reverse proxy.
NEXT_PUBLIC_API_URL=/api/v1

# ------------------------------------------------------------------------------
# Intelligence Artificielle (Chatbot)
# ------------------------------------------------------------------------------
# Activer le module IA
AI_ENABLED=true
# Modèle Ollama (ex: llama3.1:8b)
AI_MODEL=llama3.1:8b
# 3 Modes :
# - Local : "http://ollama:11434" (nécessite le profile docker "ollama-local")
# - Distant : "http://votre-serveur-gpu:11434" (vers un serveur externe)
# - Désactivé : Laissez vide ou passez AI_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
