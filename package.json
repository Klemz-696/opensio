{
  "name": "opensio",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme auto-hébergée de formation et de révision pratique pour le BTS SIO SISR",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:migrate": "pnpm --filter @opensio/api db:migrate",
    "db:generate": "pnpm --filter @opensio/api db:generate",
    "seed": "pnpm --filter @opensio/api db:seed",
    "content:sync": "pnpm --filter @opensio/api content:sync",
    "content:validate": "pnpm --filter @opensio/content-schema test",
    "check-file-size": "node scripts/check-file-size.mjs",
    "check:theme": "node scripts/check-theme-classes.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "opensio": "node scripts/opensio.mjs",
    "test:e2e": "node e2e/prepare.mjs && playwright test",
    "test:e2e:quick": "playwright test --grep @smoke",
    "secrets:generate": "node scripts/generate-secrets.mjs",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "e2e/*.spec.ts": [
      "pnpm test:e2e:quick"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.5.1",
    "turbo": "^2.10.12",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "opensio": "./scripts/opensio.mjs"
  }
}
