# ==============================================================================
# OpenSIO — Configuration pour l'environnement de Test (Template .env.test.example)
# ==============================================================================
# Ce fichier documente les variables d'environnement utilisées lors de l'exécution
# des suites de tests unitaires, d'intégration et E2E (environnement isolé opensio_test).

NODE_ENV=test

# URLs applicatives de test
APP_URL=http://localhost:3000
API_PORT=4001

# Base de données PostgreSQL dédiée aux tests (Isolation stricte de la base de dev)
DATABASE_URL=postgresql://opensio:opensio-super-secure-dev-db-pass-2026!@127.0.0.1:5432/opensio_test
DB_PASSWORD=opensio-super-secure-dev-db-pass-2026!
JWT_SECRET=4f9b8c2d1e0a7f6e5d4c3b2a1908f7e6d5c4b3a291807f6e5d4c3b2a10987654a1b2c3d4e5f60718293a4b5c6d7e8f90123456789abcdef0123456789abcdef0
REFRESH_TOKEN_TTL_DAYS=7
REGISTRATION_ENABLED=true

# Source de vérité du contenu pédagogique
CONTENT_PATH=./content
CONTENT_GIT_REMOTE=

# Moteur de lab de test
LAB_RUNNER=simulation
LAB_SESSION_TTL_MINUTES=45
LAB_MAX_GLOBAL_VMS=2
DOCKER_SOCKET_PROXY_URL=

# Terminal
TERMINAL_ENABLED=true

# Module IA en mode test
AI_ENABLED=true
AI_PROVIDER=openai-compatible
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=llama3.1:8b
AI_API_KEY=
AI_RATE_LIMIT_HOURLY=20
AI_TIMEOUT_MS=120000
