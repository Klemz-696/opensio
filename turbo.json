{
  "$schema": "https://v2-10-12.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "API_PORT",
        "DATABASE_URL",
        "JWT_SECRET",
        "REFRESH_SECRET",
        "REGISTRATION_ENABLED",
        "SINGLE_USER_MODE",
        "NODE_ENV"
      ]
    }
  }
}
