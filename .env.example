# ==============================================================================
# OpenSIO — Configuration d'environnement (Template)
# ==============================================================================

# Environnement d'exécution (development | production)
NODE_ENV=development

# URLs applicatives
APP_URL=http://localhost:3000
API_PORT=4000

# Base de données PostgreSQL (D-03)
DATABASE_URL=postgresql://opensio:change-me@localhost:5432/opensio
DB_PASSWORD=change-me

# Authentification JWT HS256 (D-09) — Secret de 64 octets minimum
JWT_SECRET=change-this-to-a-very-secure-random-64-bytes-secret-key-for-jwt-signing
REFRESH_TOKEN_TTL_DAYS=7
REGISTRATION_ENABLED=false

# Source de vérité du contenu pédagogique (D-02)
CONTENT_PATH=./content
CONTENT_GIT_REMOTE=

# Moteur d'exécution des labs (D-07, D-08) — Options: simulation | docker | proxmox
LAB_RUNNER=simulation
LAB_SESSION_TTL_MINUTES=45
LAB_MAX_GLOBAL_VMS=2
DOCKER_SOCKET_PROXY_URL=

# Terminal web (D-14, v0.2)
TERMINAL_ENABLED=false

# Cache et files de tâches (v0.2)
REDIS_URL=

# Module d'assistance IA (D-16, v0.2)
AI_ENABLED=false
AI_PROVIDER=openai-compatible
# NOTE WINDOWS / OLLAMA : Sous Windows, Node.js 18+ résout 'localhost' en IPv6 (::1).
# Si Ollama n'écoute que sur IPv4, utilisez 'http://127.0.0.1:11434/v1' au lieu de 'localhost'.
# Pour Docker/conteneur, utilisez 'http://host.docker.internal:11434/v1'.
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=llama3.1:8b
AI_API_KEY=
AI_RATE_LIMIT_HOURLY=20
# Timeout en millisecondes (défaut 120000 = 120s pour permettre le chargement du modèle en RAM au premier appel)
AI_TIMEOUT_MS=120000

# Orchestration Proxmox VE (v1.0)
PROXMOX_API_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_POOL=labs
PROXMOX_TEMPLATE_IDS=
PROXMOX_SIMULATE_FAILURE_RATE=0
NOVNC_ENABLED=false

# Notifications & SMTP (optionnel)
SMTP_URL=

# Sauvegardes (D-18)
BACKUP_DIR=/backups
BACKUP_COPY_TARGET=

# Seed — mots de passe initiaux (fallback dev si vides, obligatoires en production)
SEED_ADMIN_PASSWORD=
SEED_STUDENT_PASSWORD=